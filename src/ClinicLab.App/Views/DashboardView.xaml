<UserControl x:Class="ClinicLab.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="25">

        <StackPanel>

            <TextBlock Text="Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Bem-vindo ao ClinicLab"
                       FontSize="20"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Sistema desktop para gestão de clínica/laboratório desenvolvido em WPF, C#, MVVM, Entity Framework Core e PostgreSQL."
                       FontSize="15"
                       TextWrapping="Wrap"
                       Margin="0,0,0,30"/>

            <UniformGrid Columns="4"
                         Rows="1"
                         Margin="0,0,0,30">

                <Border BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="Pacientes"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding TotalPacientes}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="Exames"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding TotalExames}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,15,0">

                    <StackPanel>
                        <TextBlock Text="Último Paciente"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding UltimoPaciente}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#DDD"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Atualização"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding UltimaAtualizacao}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <TextBlock Text="Resumo técnico"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,15"/>

            <Border BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>
                    <TextBlock Text="Stack utilizada"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="WPF • C# • .NET • MVVM • Entity Framework Core • PostgreSQL • Repository Pattern"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="Gray"/>
                </StackPanel>
            </Border>

        </StackPanel>

    </Grid>

</UserControl>