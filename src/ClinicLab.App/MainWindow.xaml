<Window x:Class="ClinicLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicLab"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0"
                Background="#1F2937">

            <StackPanel Margin="20">

                <TextBlock Text="ClinicLab"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="Dashboard_Click"/>

                <Button Content="Pacientes"
                        Height="40"
                        Click="Pacientes_Click"/>

            </StackPanel>

        </Border>

        <!-- Área principal -->
        <ContentControl x:Name="MainContent"
                        Grid.Column="1"/>

    </Grid>

</Window>