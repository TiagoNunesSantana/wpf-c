<Window x:Class="ClinicLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicLab"
        Height="720"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Cadastro de Pacientes"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,20">

            <TextBox Width="380"
                     Height="35"
                     Margin="0,0,10,0"
                     Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Buscar"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Command="{Binding BuscarCommand}"/>

            <Button Content="Limpar Busca"
                    Width="130"
                    Height="35"
                    Command="{Binding LimparCommand}"/>

        </StackPanel>

        <Grid Grid.Row="2"
              Margin="0,0,0,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,10">

                <TextBlock Text="Nome"/>
                <TextBox Height="35"
                         Margin="0,5,0,0"
                         Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,0,10">

                <TextBlock Text="CPF"/>
                <TextBox Height="35"
                        Margin="0,5,0,0"
                        MaxLength="14"
                        Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}"
                        PreviewTextInput="Cpf_PreviewTextInput"
                        TextChanged="Cpf_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        Margin="0,0,0,10">

                <TextBlock Text="Telefone"/>
                <TextBox Height="35"
                        Margin="0,5,0,0"
                        MaxLength="15"
                        Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                        PreviewTextInput="Telefone_PreviewTextInput"
                        TextChanged="Telefone_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3">

                <TextBlock Text="Convênio"/>
                <TextBox Height="35"
                         Margin="0,5,0,0"
                         Text="{Binding Convenio, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

            <Button Content="Salvar"
                    Width="140"
                    Height="40"
                    Margin="0,0,10,0"
                    Command="{Binding SalvarCommand}"/>

            <Button Content="Excluir"
                    Width="140"
                    Height="40"
                    Margin="0,0,10,0"
                    Command="{Binding ExcluirCommand}"/>

            <Button Content="Limpar Campos"
                    Width="140"
                    Height="40"
                    Command="{Binding LimparCommand}"/>

        </StackPanel>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding Pacientes}"
                  SelectedItem="{Binding PacienteSelecionado, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome"
                                    Binding="{Binding Nome}"
                                    Width="*"/>

                <DataGridTextColumn Header="CPF"
                                    Binding="{Binding Cpf}"
                                    Width="160"/>

                <DataGridTextColumn Header="Telefone"
                                    Binding="{Binding Telefone}"
                                    Width="160"/>

                <DataGridTextColumn Header="Convênio"
                                    Binding="{Binding Convenio}"
                                    Width="180"/>

                <DataGridTextColumn Header="Cadastro"
                                    Binding="{Binding DataCadastro, StringFormat=dd/MM/yyyy HH:mm}"
                                    Width="160"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>