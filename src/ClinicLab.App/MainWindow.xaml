<Window x:Class="ClinicLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicLab"
        Height="500"
        Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="Cadastro de Pacientes"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Nome"/>

            <TextBox Height="35"
                     Margin="0,5,0,15"
                     Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Salvar"
                    Width="140"
                    Height="40"
                    Margin="0,0,0,20"
                    Command="{Binding SalvarCommand}"/>

            <DataGrid ItemsSource="{Binding Pacientes}"
                      AutoGenerateColumns="True"
                      Height="300"/>

        </StackPanel>

    </Grid>

</Window>