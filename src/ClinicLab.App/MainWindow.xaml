<Window x:Class="ClinicLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClinicLab"
        Height="560"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="25">

        <StackPanel>

            <TextBlock Text="Cadastro de Pacientes"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Nome"/>
            <TextBox Height="35"
                     Margin="0,5,0,10"
                     Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="CPF"/>
            <TextBox Height="35"
                     Margin="0,5,0,10"
                     Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Telefone"/>
            <TextBox Height="35"
                     Margin="0,5,0,10"
                     Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Convênio"/>
            <TextBox Height="35"
                     Margin="0,5,0,15"
                     Text="{Binding Convenio, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Salvar"
                    Width="140"
                    Height="40"
                    Margin="0,0,0,20"
                    Command="{Binding SalvarCommand}"/>

            <Button Content="Excluir"
                    Width="140"
                    Height="40"
                    Command="{Binding ExcluirCommand}"/>                    

            <DataGrid ItemsSource="{Binding Pacientes}"
                      SelectedItem="{Binding PacienteSelecionado, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      Height="230"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome"     Binding="{Binding Nome}"     Width="*"/>
                    <DataGridTextColumn Header="CPF"      Binding="{Binding Cpf}"      Width="130"/>
                    <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="130"/>
                    <DataGridTextColumn Header="Convênio" Binding="{Binding Convenio}" Width="130"/>
                    <DataGridTextColumn Header="Cadastro" Binding="{Binding DataCadastro, StringFormat=dd/MM/yyyy}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>

    </Grid>

</Window>
